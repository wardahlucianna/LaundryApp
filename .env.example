APP_NAME="Sunrise Laundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laundyDb
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database

VITE_APP_NAME="${APP_NAME}"

# Initial Super Admin account (used only when database has no users during db:seed)
INITIAL_SUPERADMIN_NAME="Super Admin"
INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_EMAIL=superadmin@sunrise.local
INITIAL_SUPERADMIN_PASSWORD=

# Initial Administrator account (used by AdministratorSeeder)
INITIAL_ADMIN_NAME="Administrator"
INITIAL_ADMIN_USERNAME=administrator
INITIAL_ADMIN_EMAIL=administrator@sunrise.local
INITIAL_ADMIN_PASSWORD=
